# LLM Wiki — Environment Configuration Template
# Copy to `.env` and fill in your paths.
# .env is gitignored; only this template is committed.

# Where wiki pages live (the vault itself)
OBSIDIAN_VAULT_PATH=/path/to/your/wiki

# Where source documents to ingest live (comma-separated for multiple)
OBSIDIAN_SOURCES_DIR=/path/to/your/sources

# Claude conversation history (auto-discover from ~/.claude)
CLAUDE_HISTORY_PATH=~/.claude

# Optional: semantic search via QMD (skip if not using)
# QMD_WIKI_COLLECTION=
# QMD_PAPERS_COLLECTION=
